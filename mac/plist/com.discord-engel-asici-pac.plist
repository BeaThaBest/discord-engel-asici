<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.discord-engel-asici-pac</string>
    <key>ProgramArguments</key>
    <array>
        <string>@OTO@/Discord Engel Aşıcı PAC Sunucusu (Kapatma)</string>
        <string>-m</string>
        <string>http.server</string>
        <string>1099</string>
        <string>--bind</string>
        <string>127.0.0.1</string>
        <string>--directory</string>
        <string>@APP@</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>@APP@/log/pac.log</string>
    <key>StandardErrorPath</key>
    <string>@APP@/log/pac.log</string>
</dict>
</plist>
